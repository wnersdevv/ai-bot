# ===== CORE =====
NODE_ENV=development
LOG_LEVEL=info

# ===== DATABASE =====
MONGODB_URI=mongodb://localhost:27017/wnersai

# ===== REDIS (queue, circuit breaker state, rate limit) =====
REDIS_URL=redis://localhost:6379

# ===== SECURITY =====
# 32-byte (64 hex char) key used for AES-256 encryption of stored provider API keys & bot tokens
ENCRYPTION_KEY=replace_with_64_hex_char_secret
# secret used to hash WNERSAI-issued API keys before storing
API_KEY_HASH_SECRET=replace_with_a_long_random_secret

# ===== DEFAULT / OWNER BOT (optional bootstrap bot, others are added via dashboard/API) =====
DEFAULT_BOT_TOKEN=
DEFAULT_BOT_PREFIX=w!

# ===== WEB API =====
API_PORT=3000
API_RATE_LIMIT_PER_MINUTE=60

# ===== DEFAULT RATE LIMITS (overridable per guild/user in DB) =====
USER_RATE_LIMIT_PER_MINUTE=20
